        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - ledger:transfer_availability:ratio_rate6h) / 0.005",
          "legendFormat": "availability",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
