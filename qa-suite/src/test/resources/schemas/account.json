{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Account",
  "description": "Response body for account creation.",
  "type": "object",
  "required": [
    "accountId",
    "currency",
    "floorMinor",
    "postedMinor",
    "heldMinor",
    "availableMinor"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "floorMinor": {
      "type": "integer"
    },
    "postedMinor": {
      "type": "integer"
    },
    "heldMinor": {
      "type": "integer"
    },
    "availableMinor": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
