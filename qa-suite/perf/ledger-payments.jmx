  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ledger-payments-perf" enabled="true">
      <stringProp name="TestPlan.comments">JMeter load plan for the ledger service. Host, port, threads and duration are overridable Maven properties.</stringProp>
